# Set these as process environment variables. On Windows, scripts/init-local.ps1
# generates a private .local/env.ps1 for an isolated PostgreSQL development instance.
CODEARENA_DB_URL=jdbc:postgresql://127.0.0.1:55432/codearena
CODEARENA_DB_USER=codearena
CODEARENA_DB_PASSWORD=
CODEARENA_JWT_SECRET=
CODEARENA_JUDGE_TOKEN=
CODEARENA_JUDGE_URL=http://127.0.0.1:8091
CODEARENA_FRONTEND_ORIGIN=http://127.0.0.1:5173
CODEARENA_ADMIN_PASSWORD=
# Enable only for trusted code during local development.
CODEARENA_TRUST_LOCAL_CODE=0
# Optional absolute path to a C++ compiler.
CODEARENA_CXX=
